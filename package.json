{
	"name": "@kekkon-nexus/config",
	"version": "2.260727.5",
	"bugs": "https://github.com/kekkon-nexus/config/issues",
	"license": "MIT",
	"contributors": [
		"Ryan Suhartanto <suhartanto@kekkon.nexus>",
		"Yuuki Rika <yvvki@kekkon.nexus>"
	],
	"repository": "kekkon-nexus/config",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./commitlint": {
			"types": "./dist/commitlint.d.ts",
			"default": "./dist/commitlint.js"
		},
		"./commitlint/*": {
			"types": "./dist/commitlint.*.d.ts",
			"default": "./dist/commitlint.*.js"
		},
		"./oxfmt": {
			"types": "./dist/oxfmt.d.ts",
			"default": "./dist/oxfmt.js"
		},
		"./oxlint": {
			"types": "./dist/oxlint.d.ts",
			"default": "./dist/oxlint.js"
		},
		"./ts": "./config/tsconfig.json",
		"./ts/*": "./config/tsconfig.*.json"
	},
	"scripts": {
		"prepare": "vp config",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"prepack": "tsc -p tsconfig.build.json",
		"bump": "node scripts/bump-version.ts"
	},
	"dependencies": {
		"@commitlint/config-conventional": "^21.2",
		"@commitlint/format": "^21.2",
		"@standard-config/oxlint": "^2.6.0",
		"commitlint-config-gitmoji": "^2.3.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/types": "^21.2.0",
		"@types/node": "^26.1.2",
		"oxfmt": ">=0.61.0 <1",
		"oxlint": "^1.76.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2",
		"vite-plus": "^0.2.6"
	},
	"peerDependencies": {
		"@commitlint/cli": "^21.2",
		"oxfmt": ">=0.61 <1",
		"oxlint": "^1.76",
		"oxlint-tsgolint": "^7",
		"typescript": "^7"
	},
	"peerDependenciesMeta": {
		"@commitlint/cli": {
			"optional": true
		},
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"oxlint-tsgolint": {
			"optional": true
		}
	},
	"overrides": {
		"@commitlint/types": "^21.2.0",
		"conventional-commits-parser": "^7",
		"meow": "^14",
		"oxfmt": ">=0.61 <1",
		"oxlint": "^1.76",
		"oxlint-tsgolint": "^7",
		"resolve-from": "^5",
		"vite": "npm:@voidzero-dev/vite-plus-core@^0.2.6"
	},
	"engines": {
		"node": ">=24.12"
	}
}
