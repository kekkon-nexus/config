{
	"name": "@kekkon-nexus/config",
	"version": "3.2.0",
	"description": "An opinionated config preset for TypeScript, oxlint, oxfmt and commitlint",
	"bugs": "https://github.com/kekkon-nexus/config/issues",
	"license": "MIT",
	"contributors": [
		"Ryan Suhartanto <suhartanto@kekkon.nexus>",
		"Yuuki Rika <yvvki@kekkon.nexus>"
	],
	"repository": "kekkon-nexus/config",
	"workspaces": [
		"packages/*"
	],
	"files": [
		".editorconfig",
		".vscode",
		"dist",
		"src/ts"
	],
	"type": "module",
	"exports": {
		"./editorconfig": "./.editorconfig",
		"./vscode/*": "./.vscode/*.json",
		"./ts": "./src/ts/tsconfig.json",
		"./ts/*": "./src/ts/tsconfig.*.json",
		"./commitlint": {
			"dev": "./src/commitlint/index.ts",
			"types": "./dist/commitlint/index.d.ts",
			"default": "./dist/commitlint/index.js"
		},
		"./commitlint/*": {
			"dev": "./src/commitlint/*.ts",
			"types": "./dist/commitlint/*.d.ts",
			"default": "./dist/commitlint/*.js"
		},
		"./oxfmt": {
			"dev": "./src/oxfmt/index.ts",
			"types": "./dist/oxfmt/index.d.ts",
			"default": "./dist/oxfmt/index.js"
		},
		"./oxlint": {
			"dev": "./src/oxlint/index.ts",
			"types": "./dist/oxlint/index.d.ts",
			"default": "./dist/oxlint/index.js"
		},
		"./oxlint/*": {
			"dev": "./src/oxlint/*.ts",
			"types": "./dist/oxlint/*.d.ts",
			"default": "./dist/oxlint/*.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"prepare": "vp config",
		"fmt": "NODE_OPTIONS=--conditions=dev vp fmt",
		"lint": "NODE_OPTIONS=--conditions=dev vp lint",
		"test": "NODE_OPTIONS=--conditions=dev vp test",
		"prepack": "tsc -p tsconfig.build.json",
		"pack": "bun pm pack && bun pm pack --cwd packages/create --destination ../..",
		"bump": "bun run scripts/bump.ts"
	},
	"dependencies": {
		"@commitlint/config-conventional": "^21.2.3",
		"@commitlint/format": "^21.2.3",
		"commitlint-config-gitmoji": "^2.3.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/types": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@next/eslint-plugin-next": "^16.3.6",
		"@types/bun": "latest",
		"@typescript/typescript6": "^6.0.2",
		"@vitest/eslint-plugin": "^1.6.27",
		"eslint": "^10.11.0",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jest": "^29.16.6",
		"eslint-plugin-jsdoc": "^64.5.4",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-n": "^18.3.0",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-perf": "^3.3.3",
		"eslint-plugin-react-refresh": "^0.5.7",
		"eslint-plugin-unicorn": "^76.0.0",
		"eslint-plugin-vue": "^10.11.1",
		"oxfmt": "0.70.0",
		"oxlint": "1.85.0",
		"oxlint-tsgolint": "7.0.2002",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.0",
		"vite-plus": "1.0.0-rc.0"
	},
	"peerDependencies": {
		"@commitlint/cli": "^21.2.3",
		"oxfmt": ">=0.70.0 <1",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2002",
		"typescript": "^7.0.2",
		"vite-plus": "1.0.0-rc.0"
	},
	"peerDependenciesMeta": {
		"@commitlint/cli": {
			"optional": true
		},
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"oxlint-tsgolint": {
			"optional": true
		},
		"vite-plus": {
			"optional": true
		}
	},
	"overrides": {
		"@commitlint/types": "^21.2.3",
		"@kekkon-nexus/config": "workspace:.",
		"conventional-commits-parser": "^7",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=24.12"
	}
}
