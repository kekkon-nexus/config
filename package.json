{
	"name": "@kekkon-nexus/config",
	"version": "2.260821.0",
	"bugs": "https://github.com/kekkon-nexus/config/issues",
	"license": "MIT",
	"contributors": [
		"Ryan Suhartanto <suhartanto@kekkon.nexus>",
		"Yuuki Rika <yvvki@kekkon.nexus>"
	],
	"repository": "kekkon-nexus/config",
	"type": "module",
	"exports": {
		"./ts": "./src/ts/tsconfig.json",
		"./ts/*": "./src/ts/tsconfig.*.json",
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./*/": {
			"types": "./dist/*/index.d.ts",
			"default": "./dist/*/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"prepare": "vp config",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"prepack": "tsc -p tsconfig.build.json",
		"pack": "bun pm pack",
		"bump": "bun run scripts/bump-version.ts"
	},
	"dependencies": {
		"@commitlint/config-conventional": "^21.2.2",
		"@commitlint/format": "^21.2.2",
		"commitlint-config-gitmoji": "^2.3.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/types": "^21.2.0",
		"@types/bun": "latest",
		"oxfmt": "0.64.0",
		"oxlint": "1.79.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2",
		"vite-plus": "0.3.0"
	},
	"peerDependencies": {
		"@commitlint/cli": "^21.2.2",
		"oxfmt": ">=0.64 <1",
		"oxlint": "^1.79",
		"oxlint-tsgolint": "^7",
		"typescript": "^7"
	},
	"peerDependenciesMeta": {
		"@commitlint/cli": {
			"optional": true
		},
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"oxlint-tsgolint": {
			"optional": true
		}
	},
	"overrides": {
		"@commitlint/types": "^21.2.0",
		"conventional-commits-parser": "^7",
		"vite": "npm:@voidzero-dev/vite-plus-core@^0.2.9"
	},
	"engines": {
		"node": ">=24.12"
	}
}
