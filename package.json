	"bugs": "https://github.com/kekkon-nexus/config/issues",
	"license": "MIT",
	"contributors": [
		"Ryan Suhartanto <suhartanto@kekkon.nexus>",
		"Yuuki Rika <yvvki@kekkon.nexus>"
	],
	"repository": "kekkon-nexus/config",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./commitlint": {
			"import": "./config/commitlint.ts",
			"types": "./config/commitlint.ts"
		},
		"./commitlint/*": {
			"import": "./config/commitlint.*.ts",
			"types": "./config/commitlint.*.ts"
		},
		"./oxfmt": {
			"import": "./config/oxfmt.ts",
			"types": "./config/oxfmt.ts"
		},
		"./oxlint": {
			"import": "./config/oxlint.ts",
			"types": "./config/oxlint.ts"
		},
		"./ts": "./config/tsconfig.json",
		"./ts/*": "./config/tsconfig.*.json"
	},
	"scripts": {
		"prepare": "husky",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"bump": "node scripts/bump-version.ts"
	},
	"dependencies": {
		"@commitlint/config-conventional": "^21.2",
		"@commitlint/format": "^21.2",
		"@standard-config/oxlint": "^2.5.0",
		"commitlint-config-gitmoji": "^2.3.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/types": "^21.2.0",
		"@types/node": "^26.1.1",
		"husky": "^9.1.7",
		"nano-staged": "^1.0.2",
		"oxfmt": ">=0.60.0 <1",
		"oxlint": "^1.75.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2",
		"vite-plus": "^0.2.6"
	},
	"peerDependencies": {
		"@commitlint/cli": "^21.2",
		"husky": "^9",
		"nano-staged": "^1",
		"oxfmt": ">=0.60 <1",
		"oxlint": "^1.75",
		"oxlint-tsgolint": "^7",
		"typescript": "^7"
	},
	"peerDependenciesMeta": {
		"@commitlint/cli": {
			"optional": true
		},
		"husky": {
			"optional": true
		},
		"nano-staged": {
			"optional": true
		},
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"oxlint-tsgolint": {
			"optional": true
		}
	},
	"overrides": {
		"@commitlint/types": "^21.2.0",
		"conventional-commits-parser": "^7",
		"meow": "^14",
		"oxfmt": ">=0.60 <1",
		"oxlint": "^1.75",
		"oxlint-tsgolint": "^7",
		"resolve-from": "^5",
		"vite": "npm:@voidzero-dev/vite-plus-core@^0.2.6"
	},
	"engines": {
		"node": ">=24.12"
	}
}
