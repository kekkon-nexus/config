{
	"name": "@kekkon-nexus/config",
	"version": "2.260726.1",
	"bugs": "https://github.com/kekkon-nexus/config/issues",
	"license": "MIT",
	"contributors": [
		"Ryan Suhartanto <suhartanto@kekkon.nexus>",
		"Yuuki Rika <yvvki@kekkon.nexus>"
	],
	"repository": "kekkon-nexus/config",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./commitlint": "./config/commitlint.ts",
		"./commitlint/*": "./config/commitlint.*.ts",
		"./oxfmt": "./config/oxfmt.ts",
		"./oxlint": "./config/oxlint.ts",
		"./ts": "./config/tsconfig.json",
		"./ts/*": "./config/tsconfig.*.json"
	},
	"scripts": {
		"prepare": "husky",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"build": "tsc -p tsconfig.build.json",
		"bump": "node scripts/bump-version.ts",
		"prepublishOnly": "aube run build"
	},
	"dependencies": {
		"@commitlint/config-conventional": "catalog:",
		"@commitlint/format": "catalog:",
		"@standard-config/oxlint": "catalog:",
		"commitlint-config-gitmoji": "catalog:"
	},
	"devDependencies": {
		"@commitlint/cli": "catalog:",
		"@commitlint/types": "catalog:",
		"@types/node": "catalog:",
		"husky": "catalog:",
		"nano-staged": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"@commitlint/cli": "catalog:",
		"husky": "catalog:",
		"nano-staged": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependenciesMeta": {
		"@commitlint/cli": {
			"optional": true
		},
		"husky": {
			"optional": true
		},
		"nano-staged": {
			"optional": true
		},
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"oxlint-tsgolint": {
			"optional": true
		}
	},
	"overrides": {
		"@commitlint/types": "catalog:",
		"conventional-commits-parser": "^7",
		"meow": "^14",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"resolve-from": "^5",
		"vite": "catalog:"
	},
	"engines": {
		"node": ">=24.12"
	}
}
