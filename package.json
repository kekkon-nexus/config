{
	"name": "@kekkon-nexus/config",
	"version": "4.2.0",
	"description": "An opinionated config preset for TypeScript, oxlint, oxfmt and commitlint",
	"bugs": "https://github.com/kekkon-nexus/config/issues",
	"license": "MIT",
	"contributors": [
		"Ryan Suhartanto <suhartanto@kekkon.nexus>",
		"Yuuki Rika <yvvki@kekkon.nexus>"
	],
	"repository": "kekkon-nexus/config",
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@commitlint/cli": "^21.2.4",
			"@commitlint/types": "^21.2.3",
			"@types/bun": "latest",
			"oxfmt": "0.78.0",
			"oxlint": "1.93.0",
			"oxlint-tsgolint": "7.0.2006",
			"typescript": "^7.0.2",
			"vite-plus": "^1.6.0"
		},
		"catalogs": {
			"create": {
				"@clack/prompts": "^1.9.0",
				"@optique/clack": "^1.3.6",
				"@optique/core": "^1.3.6",
				"@optique/run": "^1.3.6",
				"magic-string": "^1.4.3",
				"oxc-parser": ">=0.154.0 <1"
			},
			"prod": {
				"@commitlint/config-conventional": "^21.2.4",
				"@commitlint/format": "^21.2.3",
				"commitlint-config-gitmoji": "^2.3.1"
			},
			"test": {
				"ajv": "^8.20.0"
			},
			"upstream": {
				"@eslint/js": "^10.0.1",
				"@next/eslint-plugin-next": "^16.4.6",
				"@nuxt/eslint-config": "^1.17.0",
				"@nuxt/eslint-plugin": "^1.17.0",
				"@typescript/typescript6": "^6.0.2",
				"@vitest/eslint-plugin": "^1.6.27",
				"eslint": "^10.13.0",
				"eslint-plugin-better-tailwindcss": "^4.11.0",
				"eslint-plugin-import-x": "^4.18.1",
				"eslint-plugin-jest": "^29.17.0",
				"eslint-plugin-jsdoc": "^65.3.12",
				"eslint-plugin-jsx-a11y": "^6.10.2",
				"eslint-plugin-n": "^18.5.0",
				"eslint-plugin-promise": "^7.3.0",
				"eslint-plugin-react": "^7.37.5",
				"eslint-plugin-react-hooks": "^7.1.1",
				"eslint-plugin-react-perf": "^3.3.3",
				"eslint-plugin-react-refresh": "^0.5.7",
				"eslint-plugin-unicorn": "^79.0.0",
				"eslint-plugin-vue": "^10.12.1",
				"tailwindcss": "^4.3.5",
				"typescript-eslint": "^8.72.2"
			}
		}
	},
	"files": [
		".editorconfig",
		".vscode",
		"dist",
		"src/ts"
	],
	"type": "module",
	"exports": {
		"./editorconfig": "./.editorconfig",
		"./vscode/*": "./.vscode/*.json",
		"./ts": "./src/ts/tsconfig.json",
		"./ts/*": "./src/ts/tsconfig.*.json",
		"./commitlint": {
			"dev": "./src/commitlint/index.ts",
			"types": "./dist/commitlint/index.d.ts",
			"default": "./dist/commitlint/index.js"
		},
		"./commitlint/*": {
			"dev": "./src/commitlint/*.ts",
			"types": "./dist/commitlint/*.d.ts",
			"default": "./dist/commitlint/*.js"
		},
		"./oxfmt": {
			"dev": "./src/oxfmt/index.ts",
			"types": "./dist/oxfmt/index.d.ts",
			"default": "./dist/oxfmt/index.js"
		},
		"./oxlint": {
			"dev": "./src/oxlint/index.ts",
			"types": "./dist/oxlint/index.d.ts",
			"default": "./dist/oxlint/index.js"
		},
		"./oxlint/*": {
			"dev": "./src/oxlint/*.ts",
			"types": "./dist/oxlint/*.d.ts",
			"default": "./dist/oxlint/*.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"prepare": "vp config",
		"fmt": "NODE_OPTIONS=--conditions=dev vp fmt",
		"lint": "NODE_OPTIONS=--conditions=dev vp lint",
		"test": "NODE_OPTIONS=--conditions=dev vp test",
		"prepack": "tsc -p tsconfig.build.json",
		"pack": "bun pm pack && bun pm pack --cwd packages/create --destination ../..",
		"bump": "bun run scripts/bump.ts"
	},
	"dependencies": {
		"@commitlint/config-conventional": "catalog:prod",
		"@commitlint/format": "catalog:prod",
		"commitlint-config-gitmoji": "catalog:prod"
	},
	"devDependencies": {
		"@commitlint/cli": "catalog:",
		"@commitlint/types": "catalog:",
		"@eslint/js": "catalog:upstream",
		"@next/eslint-plugin-next": "catalog:upstream",
		"@nuxt/eslint-config": "catalog:upstream",
		"@nuxt/eslint-plugin": "catalog:upstream",
		"@types/bun": "catalog:",
		"@typescript/typescript6": "catalog:upstream",
		"@vitest/eslint-plugin": "catalog:upstream",
		"ajv": "catalog:test",
		"eslint": "catalog:upstream",
		"eslint-plugin-better-tailwindcss": "catalog:upstream",
		"eslint-plugin-import-x": "catalog:upstream",
		"eslint-plugin-jest": "catalog:upstream",
		"eslint-plugin-jsdoc": "catalog:upstream",
		"eslint-plugin-jsx-a11y": "catalog:upstream",
		"eslint-plugin-n": "catalog:upstream",
		"eslint-plugin-promise": "catalog:upstream",
		"eslint-plugin-react": "catalog:upstream",
		"eslint-plugin-react-hooks": "catalog:upstream",
		"eslint-plugin-react-perf": "catalog:upstream",
		"eslint-plugin-react-refresh": "catalog:upstream",
		"eslint-plugin-unicorn": "catalog:upstream",
		"eslint-plugin-vue": "catalog:upstream",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"tailwindcss": "catalog:upstream",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:upstream",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@nuxt/eslint-plugin": "^1.17.0",
		"eslint-plugin-better-tailwindcss": "^4.11.0",
		"oxfmt": ">=0.78.0 <1",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2006",
		"typescript": "^7.0.2",
		"vite-plus": "^1.6.0"
	},
	"peerDependenciesMeta": {
		"@commitlint/cli": {
			"optional": true
		},
		"@nuxt/eslint-plugin": {
			"optional": true
		},
		"eslint-plugin-better-tailwindcss": {
			"optional": true
		},
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"oxlint-tsgolint": {
			"optional": true
		},
		"vite-plus": {
			"optional": true
		}
	},
	"overrides": {
		"@commitlint/types": "^21.2.3",
		"@kekkon-nexus/config": "workspace:.",
		"conventional-commits-parser": "^7",
		"vite": "npm:@voidzero-dev/vite-plus-core@^1.6.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=24.12"
	}
}
