{
	"name": "@kekkon-nexus/config",
	"version": "2.260821.0",
	"bugs": "https://github.com/kekkon-nexus/config/issues",
	"license": "MIT",
	"contributors": [
		"Ryan Suhartanto <suhartanto@kekkon.nexus>",
		"Yuuki Rika <yvvki@kekkon.nexus>"
	],
	"repository": "kekkon-nexus/config",
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"exports": {
		"./ts": "./src/ts/tsconfig.json",
		"./ts/*": "./src/ts/tsconfig.*.json",
		"./*": {
			"dev": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./*/": {
			"dev": "./src/*/index.ts",
			"types": "./dist/*/index.d.ts",
			"default": "./dist/*/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"prepare": "vp config",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"prepack": "tsc -p tsconfig.build.json",
		"pack": "bun pm pack",
		"bump": "bun run scripts/bump-version.ts"
	},
	"dependencies": {
		"@commitlint/config-conventional": "^21.2.2",
		"@commitlint/format": "^21.2.2",
		"commitlint-config-gitmoji": "^2.3.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/types": "^21.2.0",
		"@eslint/js": "^10.0.1",
		"@next/eslint-plugin-next": "^16.3.3",
		"@types/bun": "latest",
		"@vitest/eslint-plugin": "^1.6.27",
		"eslint": "^10.9.1",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jest": "^29.16.5",
		"eslint-plugin-jsdoc": "^64.2.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-n": "^18.3.0",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-perf": "^3.3.3",
		"eslint-plugin-react-refresh": "^0.5.5",
		"eslint-plugin-unicorn": "^73.0.0",
		"eslint-plugin-vue": "^10.10.0",
		"oxfmt": "0.64.0",
		"oxlint": "1.79.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2",
		"typescript6": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.68.0",
		"vite-plus": "0.3.0"
	},
	"peerDependencies": {
		"@commitlint/cli": "^21.2.2",
		"oxfmt": ">=0.64.0 <1",
		"oxlint": "^1.79.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2",
		"typescript6": "npm:@typescript/typescript6@^6.0.2",
		"vite-plus": "^0.3.0"
	},
	"peerDependenciesMeta": {
		"@commitlint/cli": {
			"optional": true
		},
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"oxlint-tsgolint": {
			"optional": true
		},
		"vite-plus": {
			"optional": true
		}
	},
	"overrides": {
		"@commitlint/types": "^21.2.0",
		"conventional-commits-parser": "^7",
		"vite": "npm:@voidzero-dev/vite-plus-core@^0.2.9"
	},
	"engines": {
		"node": ">=24.12"
	}
}
