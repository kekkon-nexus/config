{
	"name": "@kekkon-nexus/config",
	"version": "2.260424.8",
	"bugs": "https://github.com/kekkon-nexus/config/issues",
	"license": "MIT",
	"contributors": [
		"Ryan Suhartanto <suhartanto@kekkon.nexus>",
		"Yuuki Rika <yvvki@kekkon.nexus>"
	],
	"repository": "kekkon-nexus/config",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./commitlint": {
			"bun": "./config/commitlint.ts",
			"default": "./dist/commitlint.js",
			"types": "./dist/commitlint.d.ts"
		},
		"./commitlint/*": {
			"bun": "./config/commitlint.*.ts",
			"default": "./dist/commitlint.*.js",
			"types": "./dist/commitlint.*.d.ts"
		},
		"./oxfmt": {
			"bun": "./config/oxfmt.ts",
			"default": "./dist/oxfmt.js",
			"types": "./dist/oxfmt.d.ts"
		},
		"./oxlint": {
			"bun": "./config/oxlint.ts",
			"default": "./dist/oxlint.js",
			"types": "./dist/oxlint.d.ts"
		},
		"./ts": "./config/tsconfig.json",
		"./ts/*": "./config/tsconfig.*.json"
	},
	"scripts": {
		"prepare": "husky",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"build": "tsc -p tsconfig.build.json",
		"bump": "bun run scripts/bump-version.ts",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@commitlint/config-conventional": "^20.5",
		"@commitlint/format": "^20",
		"commitlint-config-gitmoji": "^2.3",
		"ultracite": "~7.6"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/types": "^20.5.0",
		"@types/bun": "latest",
		"husky": "^9.1.7",
		"nano-staged": "^1.0.2",
		"oxfmt": "^0.46.0",
		"oxlint": "^1.61.0",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@commitlint/cli": "^20",
		"husky": "^9",
		"oxfmt": "^0.46",
		"oxlint": "^1.61",
		"oxlint-tsgolint": "^0.21.1",
		"typescript": "^6"
	},
	"peerDependenciesMeta": {
		"@commitlint/cli": {
			"optional": true
		},
		"husky": {
			"optional": true
		},
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		}
	}
}
