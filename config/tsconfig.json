{
	"$schema": "https://www.schemastore.org/tsconfig",
	"compilerOptions": {
		// Environment
		"composite": true,
		"module": "esnext",

		// Strictness
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,

		// Resolution
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true
	}
}
