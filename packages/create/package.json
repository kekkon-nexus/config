{
	"name": "@kekkon-nexus/create-config",
	"version": "4.2.0",
	"description": "Scaffolds @kekkon-nexus/config into a project",
	"bugs": "https://github.com/kekkon-nexus/config/issues",
	"license": "MIT",
	"contributors": [
		"Ryan Suhartanto <suhartanto@kekkon.nexus>",
		"Yuuki Rika <yvvki@kekkon.nexus>"
	],
	"repository": "kekkon-nexus/config",
	"bin": "./dist/cli.js",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"dev": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"prepack": "tsc -p tsconfig.build.json",
		"test": "vp test"
	},
	"dependencies": {
		"@clack/prompts": "catalog:create",
		"@kekkon-nexus/config": "4.2.0",
		"@optique/clack": "catalog:create",
		"@optique/core": "catalog:create",
		"@optique/run": "catalog:create",
		"magic-string": "catalog:create",
		"oxc-parser": "catalog:create",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=24.12"
	}
}
